@prefix phsm:        <http://data.europa.eu/h8v/ecmo/phsm/> .
@prefix foundation:  <http://data.europa.eu/h8v/ecmo/core/foundation/> .
@prefix hazard:      <http://data.europa.eu/h8v/ecmo/core/hazard/> .
@prefix expvuln:     <http://data.europa.eu/h8v/ecmo/core/expvuln/> .
@prefix response:    <http://data.europa.eu/h8v/ecmo/core/response/> .
@prefix instruments: <http://data.europa.eu/h8v/ecmo/core/instruments/> .
@prefix governance:  <http://data.europa.eu/h8v/ecmo/core/governance/> .
@prefix cpa:         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix dul:         <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl:         <http://www.w3.org/2002/07/owl#> .
@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# ECMO PHSM Module - Public Health (and Social) Measures - v0.1 (ECMO 2.3)
#
# A MERGED, provenance-declared taxonomy of public-health MEASURE TYPES for
# all-hazards EWRS notifications, specialising response:MeasureType. Unifies:
#   src_WHO_PHSM     : WHO/ECDC PHSM taxonomy, Annex 3, Aug 2024 (non-pharmaceutical)
#   src_JRC_Biological : JRC 'Incident management - Biological response measures' (xlsx)
#   src_JRC_EnvChem  : JRC 'Public Health Measures Taxonomy' for environmental/chemical
#                      EWRS events, Jul 2025 (complete: 6 categories / 35 measures)
# Overlapping concepts are a SINGLE node declaring every contributing source via
# phsm:fromSourceTaxonomy (+ per-source skos:notation/altLabel). Enacted measures
# reuse the ECDC-JRC Response Measures Database parameters (status, implementation,
# target group, geographic representation) and the WHO 'Settings' dimension.
#
# ECMO-as-lens reuse: PublicHealthMeasureType (r)subClassOf response:MeasureType;
# WHO non-pharmaceutical subset under phsm:PHSMType; enacted measure (r)subClassOf
# instruments:Measure; target group -> expvuln:PopulationGroupType; jurisdiction ->
# governance:Jurisdiction; settings -> dul:Place; env/chem Evacuation & Shelter-in-
# place cross-mapped (skos:relatedMatch) to response:Evacuation / response:ShelterInPlace.
#
# D&S: a *type* (PublicHealthMeasureType) is a dul:SocialObject; an *enacted*
# PublicHealthMeasure is a dul:Action. No individual is both Description and Situation.
# =============================================================================

<http://data.europa.eu/h8v/ecmo/phsm> a owl:Ontology ;
    dcterms:issued "2026-07-20"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "PHSM / Public Health Measures module of the ECMO network. A merged, provenance-declared taxonomy of public-health response-measure TYPES (WHO/ECDC PHSM + JRC biological + JRC environmental-chemical) specialising response:MeasureType, plus the ECDC-JRC Response Measures Database parametrization of an enacted measure (legal status, implementation scope, target population group, geographic scope, setting). All-hazards: biological, chemical and environmental."@en ;
    owl:imports <http://data.europa.eu/h8v/ecmo/core/response> ,
        <http://data.europa.eu/h8v/ecmo/core/instruments> ,
        <http://data.europa.eu/h8v/ecmo/core/expvuln> ,
        <http://data.europa.eu/h8v/ecmo/core/governance> ,
        <http://data.europa.eu/h8v/ecmo/core/hazard> ,
        <http://data.europa.eu/h8v/ecmo/core/foundation> ;
    owl:versionInfo "0.1" ;
    cpa:hasIntent "Give ECMO a compliant, queryable, provenance-tracked vocabulary for classifying and characterising public health measures (biological, chemical, environmental) enacted in response to health emergencies and notified on EWRS, reusing the response, instruments, expvuln and governance modules."@en ;
    cpa:scenarios "An authority enacts a measure during a health emergency (e.g. a mandatory national mask mandate on public transport; an evacuation order after a chemical release). Analysts classify it under the merged WHO/JRC taxonomy, record its legal status, implementation scope, target population group, setting and jurisdiction, and know which source taxonomies define the chosen category, so records can be exchanged and compared across the biological and environmental/chemical EWRS streams."@en ;
    cpa:coversRequirements "CQ-PHSM-P01..P12 (positive), CQ-PHSM-N01..N05 (negative); see ecmo-phsm-cqs.ttl."@en ;
    cpa:hasConsequences "Every enacted measure is an instruments:Measure classified by exactly one PublicHealthMeasureType. Measure types carry >=1 source-taxonomy provenance; overlapping concepts declare all sources. Pharmaceutical measures are flagged (phsm:isPharmaceutical) and excluded from the WHO PHSM subset. The enacted measure carries the JRC EWRS 'Measure details' layer: hasLifecycleStatus (scheduled/ongoing/completed/suspended) and hasStartDate/hasEndDate, in addition to the ECDC-JRC RMD parameters. All three source taxonomies are fully transcribed."@en ;
    cpa:hasComponent <http://data.europa.eu/h8v/ecmo/core/response> ,
        <http://data.europa.eu/h8v/ecmo/core/instruments> ,
        <http://data.europa.eu/h8v/ecmo/core/expvuln> ,
        <http://data.europa.eu/h8v/ecmo/core/governance> ;
    cpa:isSpecializationOf response:MeasureType ;
    skos:changeNote "v0.1: initial draft merging three source taxonomies (WHO/ECDC PHSM Annex 3 Aug 2024; JRC biological response measures; JRC environmental/chemical EWRS PHM taxonomy Jul 2025) plus ECDC-JRC RMD parameters, aligned to ECMO 2.3."@en ;
    skos:prefLabel "ECMO PHSM - Public Health (and Social) Measures"@en .

# ---- Provenance: source taxonomies ------------------------------------------
phsm:SourceTaxonomy a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme ;
    rdfs:label "Source Taxonomy"@en ;
    rdfs:comment "A published taxonomy contributing measure-type concepts to this merged module."@en ;
    skos:prefLabel "Source Taxonomy"@en .

phsm:fromSourceTaxonomy a owl:AnnotationProperty ;
    rdfs:label "from source taxonomy"@en ;
    rdfs:comment "Declares that a measure-type concept originates from (or also appears in) the given source taxonomy. A concept merged from several sources carries several values."@en ;
    skos:prefLabel "from source taxonomy"@en .

phsm:isPharmaceutical a owl:DatatypeProperty ;
    rdfs:domain phsm:PublicHealthMeasureType ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True for measure types that are pharmaceutical countermeasures (e.g. chemoprophylaxis, vaccination), which lie outside the WHO PHSM (non-pharmaceutical) scope."@en ;
    skos:prefLabel "is pharmaceutical"@en .

phsm:src_WHO_PHSM a phsm:SourceTaxonomy, owl:NamedIndividual ;
    dcterms:title "WHO/ECDC PHSM taxonomy - Annex 3: Policy categories and subcategories for public health and social measures (v. Aug 2024)"@en ;
    dcterms:source <https://iris.who.int/> ;
    skos:prefLabel "WHO/ECDC PHSM taxonomy (Aug 2024)"@en .
phsm:src_JRC_Biological a phsm:SourceTaxonomy, owl:NamedIndividual ;
    dcterms:title "JRC 'Incident management - Biological response measures' (ECDC-JRC RMD lineage; Euro Surveill. 2022;27(41):2101190)"@en ;
    dcterms:source <https://doi.org/10.2807/1560-7917.ES.2022.27.41.2101190> ;
    skos:prefLabel "JRC Biological response measures"@en .
phsm:src_JRC_EnvChem a phsm:SourceTaxonomy, owl:NamedIndividual ;
    dcterms:title "JRC 'Public Health Measures Taxonomy - to support environmental/chemical events notifications on EWRS' (Section 6, v. Jul 2025; 6 categories / 35 measures)"@en ;
    skos:prefLabel "JRC Environmental/Chemical response measures (EWRS, Jul 2025)"@en .

# ---- Enacted-measure properties (ECDC-JRC RMD parameters) -------------------
phsm:hasMeasureCategory a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:comment "Relates an enacted measure to the PublicHealthMeasureType that classifies it. Analogue of response:involvesMeasureType; functional (one primary code per RMD record)."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:PublicHealthMeasureType ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    skos:prefLabel "has measure category"@en, "ha categoria di misura"@it .

phsm:hasLegalStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:comment "RMD 'status': rigour of the legal basis (mandatory, voluntary, not available)."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:PHSMLegalStatus ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    skos:prefLabel "has legal status"@en, "ha stato giuridico"@it .

phsm:hasImplementationScope a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:comment "RMD 'implementation': whole target population (full) or with exemptions (partial)."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:ImplementationScope ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    skos:prefLabel "has implementation scope"@en, "ha ambito di attuazione"@it .

phsm:hasGeographicScope a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:comment "RMD 'geographical representation': administrative granularity (national, regional, local)."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:GeographicScopeLevel ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    skos:prefLabel "has geographic scope"@en, "ha ambito geografico"@it .

phsm:targetsPopulationGroup a owl:ObjectProperty ;
    rdfs:comment "RMD 'target group': indicative population group the measure is directed towards. Reuses expvuln:PopulationGroupType."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range expvuln:PopulationGroupType ;
    skos:prefLabel "targets population group"@en, "rivolto al gruppo di popolazione"@it .

phsm:appliesInSetting a owl:ObjectProperty ;
    rdfs:comment "Physical-environment setting where the measure applies (WHO 'Settings' dimension)."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:Setting ;
    rdfs:subPropertyOf dul:hasLocation ;
    skos:prefLabel "applies in setting"@en, "si applica nel contesto"@it .

phsm:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:comment "Administrative territory within which the measure applies. Reuses governance:Jurisdiction; complements phsm:hasGeographicScope."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range governance:Jurisdiction ;
    rdfs:subPropertyOf dul:hasLocation ;
    skos:prefLabel "applies in jurisdiction"@en, "si applica nella giurisdizione"@it .

phsm:addressesHazardousEvent a owl:ObjectProperty ;
    rdfs:comment "Relates a measure to the hazardous event (biological, chemical or environmental) whose transmission/impact it seeks to limit."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range hazard:HazardousEvent ;
    rdfs:subPropertyOf hazard:protectsAgainst ;
    skos:prefLabel "addresses hazardous event"@en, "affronta evento pericoloso"@it .

# ---- Measure 'details' layer (JRC EWRS: area/target, dates, current status) --
phsm:hasLifecycleStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:comment "Current lifecycle status of the enacted measure (JRC EWRS 'Measure details': scheduled, ongoing, completed, suspended). Distinct from phsm:hasLegalStatus, which records the legal rigour."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range phsm:MeasureLifecycleStatus ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    skos:prefLabel "has lifecycle status"@en, "ha stato del ciclo di vita"@it .

phsm:hasStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Date on which the measure enters into force (JRC EWRS 'Measure details')."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range xsd:date ;
    skos:prefLabel "has start date"@en .

phsm:hasEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Date on which the measure ceases to apply (JRC EWRS 'Measure details')."@en ;
    rdfs:domain phsm:PublicHealthMeasure ; rdfs:range xsd:date ;
    skos:prefLabel "has end date"@en .

# ---- Enacted measure (ECDC-JRC RMD / EWRS record) ---------------------------
phsm:PublicHealthMeasure a owl:Class ;
    rdfs:label "Public Health Measure"@en ;
    rdfs:comment "A public health measure enacted by an authority, organisation or community in response to a health emergency of any hazard type (biological, chemical, environmental). Corresponds to a response-measure / non-pharmaceutical-intervention record in the ECDC-JRC RMD and to a response measure in the JRC EWRS taxonomies. Specialises instruments:Measure (broader than NonStructuralMeasure, because the JRC taxonomy also covers pharmaceutical prophylaxis and clinical-capacity measures)."@en ;
    rdfs:subClassOf instruments:Measure ,
        [ a owl:Restriction ; owl:onProperty phsm:hasMeasureCategory ; owl:someValuesFrom phsm:PublicHealthMeasureType ] ;
    skos:altLabel "Response measure"@en, "Non-pharmaceutical intervention"@en, "NPI"@en ;
    skos:prefLabel "Public Health Measure"@en, "Misura di sanita pubblica"@it .

phsm:NonPharmaceuticalMeasure a owl:Class ;
    rdfs:label "Non-pharmaceutical Public Health Measure"@en ;
    rdfs:comment "The subset of enacted public health measures that are non-pharmaceutical (the WHO PHSM / ECDC-JRC NPI scope). Specialises instruments:NonStructuralMeasure."@en ;
    rdfs:subClassOf phsm:PublicHealthMeasure , instruments:NonStructuralMeasure ;
    skos:prefLabel "Non-pharmaceutical Public Health Measure"@en .

# ---- RMD parameter value sets (dul:Concept enumerations) --------------------
phsm:PHSMLegalStatus a owl:Class ; rdfs:subClassOf dul:Concept ; rdfs:label "PHSM Legal Status"@en ;
    rdfs:comment "Rigour of the legal basis behind a measure (ECDC-JRC RMD 'status')."@en ;
    owl:oneOf ( phsm:Mandatory phsm:Voluntary phsm:LegalStatusNotAvailable ) ; skos:prefLabel "PHSM Legal Status"@en .
phsm:Mandatory a phsm:PHSMLegalStatus, owl:NamedIndividual ; rdfs:label "Mandatory"@en ; skos:prefLabel "Mandatory"@en .
phsm:Voluntary a phsm:PHSMLegalStatus, owl:NamedIndividual ; rdfs:label "Voluntary"@en ; skos:prefLabel "Voluntary"@en .
phsm:LegalStatusNotAvailable a phsm:PHSMLegalStatus, owl:NamedIndividual ; rdfs:label "Not available"@en ; skos:prefLabel "Not available"@en .

phsm:ImplementationScope a owl:Class ; rdfs:subClassOf dul:Concept ; rdfs:label "Implementation Scope"@en ;
    rdfs:comment "Whether a measure affects the whole target population (full) or allows exemptions (partial) - RMD 'implementation'."@en ;
    owl:oneOf ( phsm:FullImplementation phsm:PartialImplementation ) ; skos:prefLabel "Implementation Scope"@en .
phsm:FullImplementation a phsm:ImplementationScope, owl:NamedIndividual ; rdfs:label "Full"@en ; skos:prefLabel "Full"@en .
phsm:PartialImplementation a phsm:ImplementationScope, owl:NamedIndividual ; rdfs:label "Partial"@en ; skos:prefLabel "Partial"@en .

phsm:GeographicScopeLevel a owl:Class ; rdfs:subClassOf dul:Concept ; rdfs:label "Geographic Scope Level"@en ;
    rdfs:comment "Administrative granularity at which a measure is implemented - RMD 'geographical representation'."@en ;
    owl:oneOf ( phsm:NationalScope phsm:RegionalScope phsm:LocalScope ) ; skos:prefLabel "Geographic Scope Level"@en .
phsm:NationalScope a phsm:GeographicScopeLevel, owl:NamedIndividual ; rdfs:label "National"@en ; skos:prefLabel "National"@en .
phsm:RegionalScope a phsm:GeographicScopeLevel, owl:NamedIndividual ; rdfs:label "Regional"@en ; skos:prefLabel "Regional"@en .
phsm:LocalScope a phsm:GeographicScopeLevel, owl:NamedIndividual ; rdfs:label "Local"@en ; skos:prefLabel "Local"@en .

phsm:MeasureLifecycleStatus a owl:Class ; rdfs:subClassOf dul:Concept ; rdfs:label "Measure Lifecycle Status"@en ;
    rdfs:comment "Current operational status of an enacted measure (JRC EWRS 'Measure details')."@en ;
    owl:oneOf ( phsm:Scheduled phsm:Ongoing phsm:Completed phsm:Suspended ) ; skos:prefLabel "Measure Lifecycle Status"@en .
phsm:Scheduled a phsm:MeasureLifecycleStatus, owl:NamedIndividual ; rdfs:label "Scheduled"@en ; skos:prefLabel "Scheduled"@en .
phsm:Ongoing a phsm:MeasureLifecycleStatus, owl:NamedIndividual ; rdfs:label "Ongoing"@en ; skos:prefLabel "Ongoing"@en .
phsm:Completed a phsm:MeasureLifecycleStatus, owl:NamedIndividual ; rdfs:label "Completed"@en ; skos:prefLabel "Completed"@en .
phsm:Suspended a phsm:MeasureLifecycleStatus, owl:NamedIndividual ; rdfs:label "Suspended"@en ; skos:prefLabel "Suspended"@en .

# ---- Settings (attributes of the physical environment; enumerated) ----------
phsm:Setting a owl:Class ; rdfs:subClassOf dul:Place ; rdfs:label "Setting"@en ;
    rdfs:comment "A physical-environment setting to which a measure applies or where it is implemented (WHO PHSM 'Settings' dimension). Instances are the enumerated setting categories."@en ; skos:prefLabel "Setting"@en .
phsm:UnspecifiedSetting a phsm:Setting, owl:NamedIndividual ; rdfs:label "Unspecified"@en ; rdfs:comment "Setting not specified, or targeting the general population."@en ; skos:prefLabel "Unspecified"@en .
phsm:BusinessesAndServices a phsm:Setting, owl:NamedIndividual ; rdfs:label "Businesses and services"@en ; rdfs:comment "Commercial establishments and enterprises (offices, retail, restaurants, gyms, manufacturing); workplaces other than health care facilities."@en ; skos:prefLabel "Businesses and services"@en .
phsm:Home a phsm:Setting, owl:NamedIndividual ; rdfs:label "Homes"@en ; rdfs:comment "Places of residence of individuals, families or households."@en ; skos:prefLabel "Homes"@en .
phsm:NursingAndCareHome a phsm:Setting, owl:NamedIndividual ; rdfs:label "Nursing and care homes"@en ; rdfs:comment "Residential facilities providing long-term personal and nursing care."@en ; skos:prefLabel "Nursing and care homes"@en .
phsm:EducationalSetting a phsm:Setting, owl:NamedIndividual ; rdfs:label "Educational settings"@en ; rdfs:comment "Educational institutions from early day care to higher education."@en ; skos:prefLabel "Educational settings"@en .
phsm:DomesticPublicTransport a phsm:Setting, owl:NamedIndividual ; rdfs:label "Domestic public transportation"@en ; rdfs:comment "Mass transport settings (buses, trains, trams, boats, ferries) and related infrastructure."@en ; skos:prefLabel "Domestic public transportation"@en .
phsm:PointOfEntryByLand a phsm:Setting, owl:NamedIndividual ; rdfs:label "Points of entry for transportation by land"@en ; rdfs:comment "Ground-based transport settings and infrastructure (land crossings, roads, railways)."@en ; skos:prefLabel "Points of entry for transportation by land"@en .
phsm:PointOfEntryByWater a phsm:Setting, owl:NamedIndividual ; rdfs:label "Points of entry for transportation by water"@en ; rdfs:comment "Water-based transport settings (shipping vessels, ferries, cruise ships, ports)."@en ; skos:prefLabel "Points of entry for transportation by water"@en .
phsm:PointOfEntryByAir a phsm:Setting, owl:NamedIndividual ; rdfs:label "Points of entry for transportation by air"@en ; rdfs:comment "Air-travel and aviation-related settings (airports, airplanes, helicopters)."@en ; skos:prefLabel "Points of entry for transportation by air"@en .
phsm:HealthCareSettingForGeneralPublic a phsm:Setting, owl:NamedIndividual ; rdfs:label "Health care settings for the general public"@en ; rdfs:comment "Health care facilities accessible to the public; excludes long-term care and measures directed at health care workers."@en ; skos:prefLabel "Health care settings for the general public"@en .
phsm:LeisureSocialCulturalOrFaithBasedSetting a phsm:Setting, owl:NamedIndividual ; rdfs:label "Leisure, social, cultural or faith-based settings"@en ; rdfs:comment "Facilities for leisure, social, cultural and faith-based activities."@en ; skos:prefLabel "Leisure, social, cultural or faith-based settings"@en .
phsm:Prison a phsm:Setting, owl:NamedIndividual ; rdfs:label "Prisons"@en ; rdfs:comment "Institutions where a state holds people deprived of their liberty."@en ; skos:prefLabel "Prisons"@en .
phsm:CampOrSettlementForRefugeesOrIDP a phsm:Setting, owl:NamedIndividual ; rdfs:label "Camps and settlements for refugees or internally displaced persons"@en ; rdfs:comment "Places providing protection and assistance to people forced to flee their homes."@en ; skos:prefLabel "Camps and settlements for refugees or internally displaced persons"@en .
phsm:InformalSettlementOrSlum a phsm:Setting, owl:NamedIndividual ; rdfs:label "Informal settlements and slums"@en ; rdfs:comment "Residential areas without security of tenure, often lacking basic services and in hazardous locations."@en ; skos:prefLabel "Informal settlements and slums"@en .
phsm:OutdoorPublicSpace a phsm:Setting, owl:NamedIndividual ; rdfs:label "Outdoor public spaces"@en ; rdfs:comment "Outdoor spaces accessible to the public (beaches, parks, playgrounds)."@en ; skos:prefLabel "Outdoor public spaces"@en .
phsm:OtherSetting a phsm:Setting, owl:NamedIndividual ; rdfs:label "Other"@en ; rdfs:comment "A setting not covered by the enumerated categories."@en ; skos:prefLabel "Other"@en .

# ---- Measure-type taxonomy roots --------------------------------------------
phsm:PublicHealthMeasureType a owl:Class, owl:NamedIndividual, response:MeasureType ;
    foundation:frameCluster foundation:F7 ;
    rdfs:subClassOf response:MeasureType ;
    rdfs:label "Public Health Measure Type"@en ;
    rdfs:comment "Top of the merged public-health measure-type taxonomy (WHO PHSM + JRC biological + JRC environmental/chemical). Every category and indicator is a subclass of this class and a punned member of response:MeasureType."@en ;
    skos:prefLabel "Public Health Measure Type"@en .

phsm:PHSMType a owl:Class, owl:NamedIndividual, response:MeasureType ;
    foundation:frameCluster foundation:F7 ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
    response:isSpecializationOfMeasureType phsm:PublicHealthMeasureType ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    rdfs:label "PHSM Type (non-pharmaceutical)"@en ;
    rdfs:comment "The WHO/ECDC PHSM (non-pharmaceutical, public-health-and-social) subset of the measure-type taxonomy. Its subclasses are the five WHO first-level categories."@en ;
    skos:prefLabel "PHSM Type"@en .

# --- WHO first-level: Active case-finding and contact identification measures ---
phsm:ActiveCaseFindingAndContactIdentificationMeasure a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PHSMType ;
    response:isSpecializationOfMeasureType phsm:PHSMType ;
    rdfs:label "Active case-finding and contact identification measures"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    skos:prefLabel "Active case-finding and contact identification measures"@en .
phsm:ActiveCaseFinding a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    rdfs:label "Active case-finding"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    phsm:fromSourceTaxonomy phsm:src_JRC_Biological ;
    skos:notation "1" ;
    skos:notation "bio.CDM.8" ;
    skos:altLabel "Screening"@en ;
    skos:prefLabel "Active case-finding"@en .
phsm:ScreeningForSymptoms a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFinding ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFinding ;
    rdfs:label "Screening for symptoms"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    skos:notation "1.1" ;
    skos:prefLabel "Screening for symptoms"@en .
phsm:TestBasedScreening a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFinding ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFinding ;
    rdfs:label "Test-based screening"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    skos:notation "1.2" ;
    skos:prefLabel "Test-based screening"@en .
phsm:ContactTracing a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFinding ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFinding ;
    rdfs:label "Contact tracing"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    phsm:fromSourceTaxonomy phsm:src_JRC_Biological ;
    skos:notation "1.3" ;
    skos:notation "bio.CDM.2" ;
    skos:altLabel "Contact tracing"@en ;
    skos:prefLabel "Contact tracing"@en .
phsm:CaseSpecificMeasure a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    rdfs:label "Case-specific measures"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    skos:notation "2" ;
    skos:prefLabel "Case-specific measures"@en .
phsm:Isolation a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:CaseSpecificMeasure ;
    response:isSpecializationOfMeasureType phsm:CaseSpecificMeasure ;
    rdfs:label "Isolation"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    phsm:fromSourceTaxonomy phsm:src_JRC_Biological ;
    skos:notation "2.1" ;
    skos:notation "bio.CDM.3" ;
    skos:altLabel "Isolation of patients"@en ;
    skos:prefLabel "Isolation"@en .
phsm:ContactSpecificMeasure a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    response:isSpecializationOfMeasureType phsm:ActiveCaseFindingAndContactIdentificationMeasure ;
    rdfs:label "Contact-specific measures"@en ;
    phsm:fromSourceTaxonomy phsm:src_WHO_PHSM ;
    skos:notation "3" ;
    skos:prefLabel "Contact-specific measures"@en .
phsm:Quarantine a owl:Class, owl:NamedIndividual, response:MeasureType ;
