    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.SCC.1" ;
    skos:prefLabel "Stopping the release of hazardous materials"@en .
phsm:ContainmentNeutralizationOrRemovalOfSource a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:SourceControlAndContainment ;
    response:isSpecializationOfMeasureType phsm:SourceControlAndContainment ;
    rdfs:label "Containment, neutralization, or removal of the source (or secondary sources)"@en ;
