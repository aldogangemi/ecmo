ph:Hantavax a idmp:MedicinalProduct ;
    ph:medicalCountermeasureType "vaccine"@en ;
    ph:sourcePage 71 ;
    ph:sourceText "[p. 71] South Korea has licensed the inactivated Hantaan virus vaccine (Hantavax), which has been in use since the 1990s (primarily for military personnel and high-risk groups). It is effective in reducing cases but requires multiple doses and regular boosters due to waning immunity."@en ;
    skos:prefLabel "Hantavax"@en ;
    prov:wasDerivedFrom ph:HERA_Virus_Prioritisation_Report ;
    idmp:hasTherapeuticIndication ph:Hantavax_Haemorrhagic_Fever_With_Renal_Syndrome_PREVENTION_Indication .

