# --- New first-level: Medical response ---
phsm:MedicalResponse a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
    response:isSpecializationOfMeasureType phsm:PublicHealthMeasureType ;
    rdfs:label "Medical response"@en ;
    rdfs:comment "JRC environmental/chemical taxonomy (EWRS, Jul 2025): clinical and toxicological response to affected individuals. Overlaps the ECMO Medical Countermeasures (mcmc) branch; 'antidotes and specific toxicological treatments' is pharmaceutical."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:prefLabel "Medical response"@en .
phsm:AmbulatoryConsultation a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Provision of ambulatory consultations"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.1" ;
    skos:prefLabel "Provision of ambulatory consultations"@en .
phsm:HospitalizationOfAffectedIndividuals a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Hospitalization for affected individuals"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.2" ;
    skos:prefLabel "Hospitalization for affected individuals"@en .
phsm:AdministrationOfAntidotesAndToxicologicalTreatment a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Administration of antidotes and specific toxicological treatments"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.3" ;
    phsm:isPharmaceutical true ;
    skos:prefLabel "Administration of antidotes and specific toxicological treatments"@en .
phsm:PsychologicalFirstAid a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Provision of Psychological First Aid (PFA)"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.4" ;
    skos:prefLabel "Provision of Psychological First Aid (PFA)"@en .
phsm:ManagementAndIdentificationOfDeceased a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Management and identification of deceased individuals"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.5" ;
    skos:prefLabel "Management and identification of deceased individuals"@en .
phsm:RapidBiomonitoringProgramForExposedPeople a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Rapid implementation of a biomonitoring program for exposed people"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.6" ;
    skos:closeMatch phsm:BiomonitoringOfHumansOrEcosystems ;
    skos:prefLabel "Rapid implementation of a biomonitoring program for exposed people"@en .
phsm:HealthMonitoringAndClinicalFollowUp a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:MedicalResponse ;
    response:isSpecializationOfMeasureType phsm:MedicalResponse ;
    rdfs:label "Health monitoring and clinical follow-up of exposed populations"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.MED.7" ;
    skos:prefLabel "Health monitoring and clinical follow-up of exposed populations"@en .

# --- New first-level: International coordination and support ---
phsm:InternationalCoordinationAndSupport a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
    response:isSpecializationOfMeasureType phsm:PublicHealthMeasureType ;
    rdfs:label "International coordination and support"@en ;
    rdfs:comment "JRC environmental/chemical taxonomy (EWRS, Jul 2025): cross-border notification, coordination and assistance-request measures. Aligns with the ECMO EWRS and CECIS/UCPM source modules."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:prefLabel "International coordination and support"@en .
phsm:NotificationOfEarlyWarningSystems a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InternationalCoordinationAndSupport ;
    response:isSpecializationOfMeasureType phsm:InternationalCoordinationAndSupport ;
    rdfs:label "Notification of early warning systems (e.g. EWRS, IHR)"@en ;
    rdfs:comment "Aligns with the ECMO EWRS module (ecmo-ewrs)."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.ICS.1" ;
    skos:prefLabel "Notification of early warning systems (e.g. EWRS, IHR)"@en .
phsm:CrossBorderInformationSharing a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InternationalCoordinationAndSupport ;
    response:isSpecializationOfMeasureType phsm:InternationalCoordinationAndSupport ;
    rdfs:label "Cross-border information sharing and collaboration"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.ICS.2" ;
    skos:prefLabel "Cross-border information sharing and collaboration"@en .
phsm:ActivationOfTreatiesOrEmergencyPlans a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InternationalCoordinationAndSupport ;
    response:isSpecializationOfMeasureType phsm:InternationalCoordinationAndSupport ;
    rdfs:label "Activation of treaties, bilateral or multinational emergency plans"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.ICS.3" ;
    skos:prefLabel "Activation of treaties, bilateral or multinational emergency plans"@en .
phsm:RequestOfUCPMActivation a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InternationalCoordinationAndSupport ;
    response:isSpecializationOfMeasureType phsm:InternationalCoordinationAndSupport ;
    rdfs:label "Request of UCPM activation"@en ;
    rdfs:comment "Aligns with the ECMO CECIS / Union Civil Protection Mechanism module (ecmo-cecis)."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.ICS.4" ;
    skos:prefLabel "Request of UCPM activation"@en .
phsm:RequestForInternationalAssistance a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InternationalCoordinationAndSupport ;
    response:isSpecializationOfMeasureType phsm:InternationalCoordinationAndSupport ;
    rdfs:label "Request for other international assistance or specialized resources"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.ICS.5" ;
    skos:prefLabel "Request for other international assistance or specialized resources"@en .

# --- New first-level: Communication and information ---
phsm:CommunicationAndInformation a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
    response:isSpecializationOfMeasureType phsm:PublicHealthMeasureType ;
    rdfs:label "Communication and information"@en ;
    rdfs:comment "JRC environmental/chemical taxonomy (EWRS, Jul 2025): risk-communication and public-information measures. Cross-branch closeMatch to the JRC-biological 'General' communication measures."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:prefLabel "Communication and information"@en .
phsm:PublicCommunicationOnRisksAndInstructions a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:CommunicationAndInformation ;
    response:isSpecializationOfMeasureType phsm:CommunicationAndInformation ;
    rdfs:label "Public communication on risks, protective measures, restriction of access, clean-up measures or other instructions"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.CIN.1" ;
    skos:closeMatch phsm:CommunicationToThePublic ;
    skos:prefLabel "Public communication on risks, protective measures, restriction of access, clean-up measures or other instructions"@en .
phsm:CommunicationToProfessionals a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:CommunicationAndInformation ;
    response:isSpecializationOfMeasureType phsm:CommunicationAndInformation ;
    rdfs:label "Communication to professionals (healthcare providers, emergency services)"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.CIN.2" ;
    skos:closeMatch phsm:CommunicationToHealthcareServices ;
    skos:prefLabel "Communication to professionals (healthcare providers, emergency services)"@en .
phsm:AddressingMisinformationAndPanic a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:CommunicationAndInformation ;
    response:isSpecializationOfMeasureType phsm:CommunicationAndInformation ;
    rdfs:label "Addressing misinformation and panic through official updates or denials"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.CIN.3" ;
    skos:prefLabel "Addressing misinformation and panic through official updates or denials"@en .
phsm:ActivationOfEmergencyHotlinesOrPlatforms a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:CommunicationAndInformation ;
    response:isSpecializationOfMeasureType phsm:CommunicationAndInformation ;
    rdfs:label "Activation of emergency hotlines or online information platforms"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.CIN.4" ;
    skos:prefLabel "Activation of emergency hotlines or online information platforms"@en .
