phsm:RecallOfContaminatedFoodItems a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:ExposureLimitationForHumansOrEcosystem ;
    response:isSpecializationOfMeasureType phsm:ExposureLimitationForHumansOrEcosystem ;
