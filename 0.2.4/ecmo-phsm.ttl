    rdfs:comment "JRC environmental/chemical taxonomy (EWRS, Jul 2025): protective actions limiting exposure of humans or the ecosystem to a released hazard."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
