@prefix cqs:         <http://data.europa.eu/h8v/ecmo/cqs/> .
@prefix cpa:         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix dul:         <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix fschema:     <https://w3id.org/framester/schema/> .
@prefix foundation:  <http://data.europa.eu/h8v/ecmo/core/foundation/> .
@prefix hazard:      <http://data.europa.eu/h8v/ecmo/core/hazard/> .
@prefix ph:          <http://data.europa.eu/h8v/ecmo/public-health/> .
@prefix impact:      <http://data.europa.eu/h8v/ecmo/core/impact/> .
@prefix owl:         <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# ECMO 0.3.0 — NEW regression CQs & shapes (proposal stub)
# Covers the 0.3.0 additions not yet exercised by the test suite:
#   (1) D&S boundary guard      — locks in the InfectiousDiseaseOrPathogen fix
#   (2) subsumedUnder-not-subClassOf guard for hazard framing
#   (3) assessment redesign     — foundation:assesses / isAssessedBy / Assessment
#   (4) DUL-alignment traversal  — entailments from the v0.4 property alignments
# Executable: cpa:hasUnitTest carries the SPARQL; polarity=negative means the
# query MUST return no rows (a non-empty result is a defect, b33-NEGCQ).
# Run over the *reasoned* 0.3.0 network (core + public-health + hera + DUL/d0).
# =============================================================================

<http://data.europa.eu/h8v/ecmo/cqs/regression-0.3.0> a owl:Ontology ;
    dcterms:issued "2026-08-06"^^xsd:date ;
    owl:imports <http://data.europa.eu/h8v/ecmo/core> , <http://data.europa.eu/h8v/ecmo/cqs> ;
    owl:versionInfo "0.3.0" ;
    rdfs:comment "Regression competency questions added for ECMO 0.3.0. Additive to ecmo-cqs / ecmo-cqs-extended."@en ;
    skos:prefLabel "ECMO 0.3.0 regression CQs"@en .

# -----------------------------------------------------------------------------
# (1) Description ⊓ Situation must stay empty — guards the D&S bug that made
#     InfectiousDisease / InfectiousDiseaseOrSyndrome unsatisfiable.
# -----------------------------------------------------------------------------
cqs:CQ-DS-N01 a cqs:NegativeCompetencyQuestion ;
    cqs:hasNLText "Is any class simultaneously a dul:Description and a dul:Situation? (MUST be none.)"@en ;
    cqs:hasPolarity "negative" ;
    cqs:testKind "ASK" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/core> ;
    cqs:exercisesPattern "descriptionandsituation" ;
    cpa:hasUnitTest """
ASK {
  ?c a owl:Class ;
     rdfs:subClassOf dul:Description ;
     rdfs:subClassOf dul:Situation .
}""" ;
    skos:prefLabel "CQ-DS-N01 — no class is both Description and Situation"@en .

# -----------------------------------------------------------------------------
# (2) Hazard framing must be intensional: no disease/pathogen class may reach
#     both hazard:BiologicalHazard and ph:HealthCondition via rdfs:subClassOf.
#     (Attach hazard typing via fschema:subsumedUnder instead.)
# -----------------------------------------------------------------------------
cqs:CQ-DS-N02 a cqs:NegativeCompetencyQuestion ;
    cqs:hasNLText "Is any class rdfs:subClassOf both hazard:BiologicalHazard and ph:HealthCondition? (MUST be none — use fschema:subsumedUnder for the hazard frame.)"@en ;
    cqs:hasPolarity "negative" ;
    cqs:testKind "ASK" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/public-health> ;
    cqs:exercisesPattern "descriptionandsituation" ;
    cpa:hasUnitTest """
ASK {
  ?c rdfs:subClassOf+ hazard:BiologicalHazard ;
     rdfs:subClassOf+ ph:HealthCondition .
}""" ;
    skos:prefLabel "CQ-DS-N02 — disease/pathogen not subClassOf into the hazard Description branch"@en .

# -----------------------------------------------------------------------------
# (3) Assessment redesign — every foundation:Assessment relates to what it
#     assesses (positive), and no Assessment is rdfs:subClassOf a Description
#     anchor (negative).
# -----------------------------------------------------------------------------
cqs:CQ-ASSESS-P01 a cqs:CompetencyQuestion ;
    cqs:hasNLText "For each Assessment, what entity does it assess (foundation:assesses) and what is it an assessment of (inverse foundation:isAssessedBy)?"@en ;
    cqs:hasPolarity "positive" ;
    cqs:testKind "SELECT" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/core/foundation> ;
    cqs:exercisesPattern "objectrole" ;
    cpa:hasUnitTest """
SELECT ?assessment ?assessed ?bearer WHERE {
  ?assessment a foundation:Assessment .
  OPTIONAL { ?assessment foundation:assesses ?assessed . }
  OPTIONAL { ?bearer foundation:isAssessedBy ?assessment . }
}""" ;
    skos:prefLabel "CQ-ASSESS-P01 — assessment reaches its assessed entity"@en .

cqs:CQ-ASSESS-N01 a cqs:NegativeCompetencyQuestion ;
    cqs:hasNLText "Is any foundation:Assessment a subclass of a Description anchor (e.g. Hazard/Risk)? (MUST be none — assessments are Process ⊔ InformationEntity, not Descriptions.)"@en ;
    cqs:hasPolarity "negative" ;
    cqs:testKind "ASK" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/core/foundation> ;
    cqs:exercisesPattern "descriptionandsituation" ;
    cpa:hasUnitTest """
ASK {
  ?a rdfs:subClassOf* foundation:Assessment ;
     rdfs:subClassOf+ dul:Description .
}""" ;
    skos:prefLabel "CQ-ASSESS-N01 — assessments are not Descriptions"@en .

# -----------------------------------------------------------------------------
# (4) DUL-alignment traversal — the v0.4 property alignments must let a reasoner
#     reach DUL-level relations. hazard:hasImpact ⊑ dul:sameSettingAs, so an
#     event and its impact must be sameSettingAs after materialisation.
# -----------------------------------------------------------------------------
cqs:CQ-ALIGN-P01 a cqs:CompetencyQuestion ;
    cqs:hasNLText "Given a HazardousEvent and its Impact (hazard:hasImpact), does the DUL-level dul:sameSettingAs relation hold between them (via the v0.4 alignment)?"@en ;
    cqs:hasPolarity "positive" ;
    cqs:testKind "SELECT" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/property-alignments> ;
    cqs:exercisesPattern "participation" ;
    cpa:hasUnitTest """
SELECT ?event ?impact WHERE {
  ?event hazard:hasImpact ?impact .
  ?event dul:sameSettingAs ?impact .
}""" ;
    skos:prefLabel "CQ-ALIGN-P01 — hazard:hasImpact entails dul:sameSettingAs"@en .

cqs:CQ-ALIGN-P02 a cqs:CompetencyQuestion ;
    cqs:hasNLText "Which entities are classified by a Concept through a property aligned to dul:isClassifiedBy (e.g. hazard:hasHazardCategory, response:involvesMeasureType)?"@en ;
    cqs:hasPolarity "positive" ;
    cqs:testKind "SELECT" ;
    cqs:targetsModule <http://data.europa.eu/h8v/ecmo/property-alignments> ;
    cqs:exercisesPattern "classification" ;
    cpa:hasUnitTest """
SELECT ?x ?concept WHERE {
  ?x dul:isClassifiedBy ?concept .
}""" ;
    skos:prefLabel "CQ-ALIGN-P02 — dul:isClassifiedBy roll-up over the aligned classifiers"@en .
