ph:Veklury_COVID_19_TREATMENT_Indication a idmp:TherapeuticIndication ;
    ph:sourcePage 31 ;
    ph:sourceText "[p. 31] Remdesivir (Veklury; Gilead Sciences Ireland UC) is an intravenous antiviral authorised for hospitalised and early out-patient use. Its efficacy is symptom onset."@en ;
    prov:wasDerivedFrom ph:HERA_Virus_Prioritisation_Report ;
    idmp:hasIndicationAsDiseaseSymptomProcedure ph:COVID_19 ;
