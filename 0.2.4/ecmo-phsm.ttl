# --- New first-level: Medical countermeasure and prophylaxis measures ---
phsm:MedicalCountermeasureAndProphylaxis a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
