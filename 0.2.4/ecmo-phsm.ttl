    skos:prefLabel "Environmental sampling to identify / confirm hazards"@en .
phsm:MonitoringOfAirWaterAndSoil a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:InvestigationAndEnvironmentalMonitoring ;
    response:isSpecializationOfMeasureType phsm:InvestigationAndEnvironmentalMonitoring ;
    rdfs:label "Monitoring of air, water and soil to assess contamination extent"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.INV.4" ;
    skos:prefLabel "Monitoring of air, water and soil to assess contamination extent"@en .
phsm:BiomonitoringOfHumansOrEcosystems a owl:Class, owl:NamedIndividual, response:MeasureType ;
