    skos:altLabel "BDBV"@en,
        "Bundibugyo virus"@en ;
    skos:prefLabel "Bundibugyo ebolavirus"@en .

ph:CCHFV_DNA_Vaccine_Candidate_Crimean_Congo_Haemorrhagic_Fever_PREVENTION_Indication a idmp:TherapeuticIndication ;
    ph:sourcePage 74 ;
    ph:sourceText "[p. 74] Several vaccine candidates are under development, including inactivated, DNA-based and viral-vector-based vaccines. A DNA vaccine encoding the CCHFV glycoprotein precursor has demonstrated protective efficacy in preclinical lethal mouse models."@en ;
    rdfs:comment "Demonstrated protective efficacy in preclinical lethal mouse models."@en ;
    prov:wasDerivedFrom ph:HERA_Virus_Prioritisation_Report ;
    idmp:hasIndicationAsDiseaseSymptomProcedure ph:Crimean_Congo_Haemorrhagic_Fever ;
    idmp:isApplicableIn ph:Global .

