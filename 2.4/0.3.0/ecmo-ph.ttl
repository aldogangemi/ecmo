ph:Kostaive_COVID_19_PREVENTION_Indication a idmp:TherapeuticIndication ;
    ph:sourcePage 30 ;
    ph:sourceText "[p. 30] ARCT-154 (Kostaive) is a self-amplifying mRNA vaccine that received EU marketing authorisation in February 2025. EPAR data indicate that neutralising responses are not inferior to those of first-generation mRNA boosters when using a lower mRNA dose. As of October 2025, ongoing post-authorisation surveillance was confirming favourable safety and immunogenicity profiles."@en ;
    dcterms:date "2025-02"^^xsd:gYearMonth ;
    prov:wasDerivedFrom ph:HERA_Virus_Prioritisation_Report ;
    idmp:hasIndicationAsDiseaseSymptomProcedure ph:COVID_19 ;
    idmp:isApplicableIn cmns-ge-euj:EuropeanUnion .

