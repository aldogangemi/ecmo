# --- New first-level: Source control and containment ---
phsm:SourceControlAndContainment a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:PublicHealthMeasureType ;
    response:isSpecializationOfMeasureType phsm:PublicHealthMeasureType ;
    rdfs:label "Source control and containment"@en ;
    rdfs:comment "JRC environmental/chemical taxonomy (EWRS, Jul 2025): measures acting on the hazard source to stop or slow release/dispersion."@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:prefLabel "Source control and containment"@en .
phsm:StoppingReleaseOfHazardousMaterials a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:SourceControlAndContainment ;
    response:isSpecializationOfMeasureType phsm:SourceControlAndContainment ;
