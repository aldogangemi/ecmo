    skos:notation "env.SCC.2" ;
    skos:prefLabel "Containment, neutralization, or removal of the source (or secondary sources)"@en .
phsm:InstallationOfBarriersOrAbsorbents a owl:Class, owl:NamedIndividual, response:MeasureType ;
    rdfs:subClassOf phsm:SourceControlAndContainment ;
    response:isSpecializationOfMeasureType phsm:SourceControlAndContainment ;
    rdfs:label "Installation of barriers or absorbents to slow or block dispersion"@en ;
    phsm:fromSourceTaxonomy phsm:src_JRC_EnvChem ;
    skos:notation "env.SCC.3" ;
    skos:prefLabel "Installation of barriers or absorbents to slow or block dispersion"@en .

# --- New first-level: Exposure limitation for humans or ecosystem ---
phsm:ExposureLimitationForHumansOrEcosystem a owl:Class, owl:NamedIndividual, response:MeasureType ;
